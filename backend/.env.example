# =========================================================================
# PLACEMENT MANAGEMENT SYSTEM — BACKEND ENVIRONMENT CONFIGURATION
# =========================================================================

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/placement_management
JWT_SECRET=placement_management_jwt_secret_key_2026_super_secure
JWT_EXPIRE=30d

# =========================================================================
# REAL-WORLD EMAIL SYSTEM & SMTP DISPATCH CONFIGURATION
# =========================================================================

# SMTP Server Host
# Examples:
#   Gmail: smtp.gmail.com
#   Brevo: smtp-relay.brevo.com
#   SendGrid: smtp.sendgrid.net
#   Amazon SES: email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP Secure Connection (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Authenticated Username / Account Email
SMTP_USER=your-placement-office@gmail.com

# SMTP Authenticated Password / App Password / API Key
# (For Gmail: Use 16-character App Password generated under 2-Step Verification)
SMTP_PASS=your-16-character-app-password

# Default Verified Platform Sender Email Address
FROM_EMAIL=your-placement-office@gmail.com

# Display Name for Outbound Placement Emails
FROM_NAME=University Placement Cell

# Optional Inbound Webhook Shared Secret Token (for webhook signature verification)
INBOUND_WEBHOOK_SECRET=your_secure_inbound_secret_token
